# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust/Anchor build artifacts
/target/

# Lockfiles (use npm, not pnpm)
pnpm-lock.yaml

# Dev scripts (not needed in repo)
*.ps1
check-*.ts
test-*.ts
verify-*.ts

# Documentation (keep README.md only)
CUSTOM_PROGRAM_ANALYSIS.md
PRIVACY_CUSTOM_PROGRAM.md
ONCHAIN_NULLIFIER_IMPLEMENTATION.md
NULLIFIER_SYSTEM.md
BUILD_*.md
DEPLOY_*.md
DEV_*.md
HANDOFF_*.md
IMPLEMENTATION_*.md
LIGHT_PROTOCOL_*.md
MAINNET_*.md
MANUAL_*.md
NEXT_AGENT_*.md
PROJECT_*.md
QUICK_*.md
WHERE_TO_*.md

# Docker files (not needed for Vercel deployment)
Dockerfile
.dockerignore
docker-compose*.yml

# Other unnecessary files
.relayer-fees.json
.vercel-deploy
pnpmfile.cjs
